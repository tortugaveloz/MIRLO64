# 2-cycle with CONVERT_ONE and BI_LERP_1 off (G_TC_FILTCONV) on a tile that is not YUV: the second pass converts the first's
# texel (the oracle does whatever the tile's format): R = Y + K0 V, G = Y + K1 U + K2 V, B = Y + K3 U, U V Y the texel's R G B as
# they are (a YUV tile's less 128), and TEXEL1 is it. The first combiner cycle gives TEXEL1, the second COMBINED.
rdram zero
mem 200000 f8010001000107c1003f003f003f003f
cmd 3f10013f 00100000
cmd 2d000000 005003c0
cmd 3d100003 00200000
cmd 35100200 07000000
cmd 27000000 00000000
cmd 34000000 0700c000
cmd 3d100003 00200008
cmd 35100201 07000000
cmd 27000000 00000000
cmd 34000000 0700c000
cmd 27000000 00000000
cmd 35100200 00000020
cmd 32000000 0000c000
cmd 35100201 01000000
cmd 32000000 0100c000
cmd 2c020201 00100000
cmd 2f100af0 00000000
cmd 3cffffff fffd7438
cmd 0a800040 00400020 001c0000 00000000 00080000 00000000 001c0000 00000000 00800080 7fff0000 00200000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000
cmd 29000000 00000000
