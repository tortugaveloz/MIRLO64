# ==============================================================================
# The overclocked build: the same project as mirlo.qsf with the RSP of rtl/rsp_oc on the game CPU's clock
# (docs/mips.md, "The RSP's clock"). Compile it as a revision: quartus_sh --flow compile mirlo -c mirlo_oc
# (tools/area2/fit.sh: REV=mirlo_oc); the bitstream is output_files/mirlo_oc.rbf. mirlo.qsf's own revision is
# the faithful build, the RSP as the console has it on the system clock.
# ==============================================================================
source mirlo.qsf
set_global_assignment -name VERILOG_MACRO "MIRLO_RSP_OC=1"

# The seed this revision closes timing with (the sources as they are: the Analogizer's video -- RGBHV without the line doubler -- and the SNAC port
# with the Video settings, the 2x caches, the arbiter's PRE and MAXB and the D-cache's 16-byte line fill: all 128 slack lines of mirlo_oc.sta.summary
# >= 0, worst setup +0.167 ns and worst hold +0.105 ns, 298 of 308 RAM blocks, 18,179 ALMs of 18,480, 1,844 of 1,848 LABs, 54 of 66 DSP blocks).
# The design is at the device's limit of LABs: most seeds stop in the fitter's packing ("requires 1,850 to 1,870 LABs", 1,848 on the device); of
# the two seeds tried on this tree, 13 stopped there (1,850) and 14 placed and closed. tools/area2/fit.sh writes the seed it
# is asked for here too, so a sweep is not overridden; a change of the hardware's sources makes this one stale.
set_global_assignment -name SEED 14

# The synthesis shares the arithmetic units that are used one at a time (the RDP alone -22 ALUTs; seed 13 of the full design,
# line doubler included, asked for 1,862 LABs of the fitter's packing without it and 1,853 with it).
set_global_assignment -name AUTO_RESOURCE_SHARING ON

# No physical synthesis of combinational logic for performance (the fitter's boolean-division resynthesis of the paths that miss timing:
# PHYSICAL_SYNTHESIS_COMBO_LOGIC ON in mirlo.qsf). In the fit of this design it made 1,175 LUTs and deleted 745 (+430 and the packing around them): the same
# sources, seed 3, 18,300 ALMs and 1,851 LABs asked for with it (the fit stops: 1,848 on the device) and 17,613 ALMs (95 %) and 1,848 LABs placed
# without it. The register duplication and the fitter's placement-time optimisations stay on. The netlist's function is the same either way.
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC OFF
