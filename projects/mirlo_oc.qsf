# ==============================================================================
# The overclocked build: the same project as mirlo.qsf with the RSP of rtl/rsp_oc on the game CPU's clock
# (docs/mips.md, "The RSP's clock"). Compile it as a revision: quartus_sh --flow compile mirlo -c mirlo_oc
# (tools/area2/fit.sh: REV=mirlo_oc); the bitstream is output_files/mirlo_oc.rbf. mirlo.qsf's own revision is
# the faithful build, the RSP as the console has it on the system clock.
# ==============================================================================
source mirlo.qsf
set_global_assignment -name VERILOG_MACRO "MIRLO_RSP_OC=1"

# The seed this revision closes timing with (the sources as they are, with the arbiter's PRE and MAXB and the D-cache's 16-byte line fill: all 128 slack
# lines of mirlo_oc.sta.summary >= 0, worst +0.061 ns, 295 of 308 RAM blocks, 17,752 ALMs of 18,480, 49 of 66 DSP blocks; of 9 seeds fitted, 1 closed it
# (13), and the nearest others were -0.028 (2, a hold in the fast corner) and -0.035 ns (10)). tools/area2/fit.sh writes the seed it
# is asked for here too, so a sweep is not overridden; a change of the hardware's sources makes this one stale.
set_global_assignment -name SEED 13
