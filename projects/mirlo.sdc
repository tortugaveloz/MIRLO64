# ==============================================================================
# The PSRAMs (rtl/soc/psram.sv: a ROM's first 32 MiB) are driven asynchronously, every pin a register at its pad
# (projects/mirlo.qsf) held for whole cycles of clk_sys -- 96 ns from the address to the data taken, against the chips'
# 70 -- and their clock is never started: nothing to constrain.
# ==============================================================================

# ==============================================================================
# rsp_xing's held values (rtl/soc/rsp_xing.sv): clk_r's registers that a value is announced with and held in -- a DPC write's word (ds_wd, ds_k: held
# while the RSP's clock waits for the write to go in), an answer to the host port (hr_q) -- and the status the RSP reads from clk's registers (dq_*:
# sampled, any of the values it takes will do) are taken by registers on the other clock, which the clocks arrive at 1.2 ns apart (clk_cpu first). Setup is
# timed at the closest edges, 5.3 ns, as ever; hold is not asked: the value is not changing in the cycle it is taken (or any of them may be), and the
# fitter's delay of the data -- 0.0 to 0.2 ns, seed by seed -- is what left -0.02 ns of hold in the fast corner in tm2_3 (ds_wd -> rdp_dpc's xbus).
# ==============================================================================
set_false_path -hold -from [get_registers {*rsp_xing:oc.xing|ds_wd[*]}]
set_false_path -hold -from [get_registers {*rsp_xing:oc.xing|ds_k[*]}]
set_false_path -hold -from [get_registers {*rsp_xing:oc.xing|hr_q[*]}]
set_false_path -hold -from [get_registers {*rsp_xing:oc.xing|dq_start[*]}]
set_false_path -hold -from [get_registers {*rsp_xing:oc.xing|dq_end[*]}]
set_false_path -hold -from [get_registers {*rsp_xing:oc.xing|dq_current[*]}]
set_false_path -hold -from [get_registers {*rsp_xing:oc.xing|dq_status[*]}]

# ==============================================================================
# cpu_port's request (rtl/soc/cpu_port.sv): rq_addr, rq_dev, rq_line, rq_half are clk_c's registers, written as rq_t turns over and held until the read is
# done, and clk takes them (a_*) at every edge together with rq_t (t_s): the request is used when t_s says it is new, so a_* that came an edge early is the
# same value used a cycle later, and that is all a hold violation can be here (setup, at the closest edges, stays). The fitter left -0.05 ns in the fast
# corner in tm3_6 (rq_addr -> a_addr).
# ==============================================================================
set_false_path -hold -from [get_registers {*cpu_port:pc|rq_addr[*]}]
set_false_path -hold -from [get_registers {*cpu_port:pc|rq_dev}]
set_false_path -hold -from [get_registers {*cpu_port:pc|rq_line}]
set_false_path -hold -from [get_registers {*cpu_port:pc|rq_half}]

# ==============================================================================
# The reset's way into the game CPU's clock (rtl/soc/mirlo_mips.sv): rst_cpu_m is the first register of a synchroniser (rst_cpu_m, rst_cpu) on clk_cpu,
# whose data is clk's reset_r -- a level that rises at power-up and holds for milliseconds, a case where the first register is allowed to go
# metastable and the second takes what it settles to. The fitter's placement of that one pair -- the reset's flop by its source, rst_cpu_m by the
# synchroniser's loads -- left the setup of the path between the two clocks at -0.06 to -0.09 ns in two seeds of 12 (reset_r -> rst_cpu_m).
# ==============================================================================
set_false_path -to [get_registers {*mirlo_mips:soc|rst_cpu_m}]
