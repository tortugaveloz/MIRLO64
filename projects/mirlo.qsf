# ==============================================================================
# Quartus Prime Settings File
# Generated by OpenGateware - Gateman CLI v0.1.0
# ==============================================================================
# WARNING: DO NOT ADD FILES TO THE PROJECT VIA THE QUARTUS IDE!
# Add them manually to mirlo.qip or Quartus will overwrite this file.
# ==============================================================================

# ==============================================================================
# Project-Wide Assignments
# ==============================================================================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.1
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name TOP_LEVEL_ENTITY apf_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ==============================================================================
# Compiler Assignments
# ==============================================================================
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
# Parts of the design this build leaves out (Verilog macros):
# the geom CFU's edge-setup ops (0x62, 0x64..0x67) and blend ops (0x40/0x41/
# 0x46) -- MRDP's triangle setup does that work -- -403 ALMs, -2 DSP;
set_global_assignment -name VERILOG_MACRO "SU_NO_EDGE=1"
set_global_assignment -name VERILOG_MACRO "SU_NO_BLEND=1"
# MRDP's 2-cycle mode and texture rectangles (1-cycle triangles and fill
# rectangles only), -540 ALMs, -7 DSP; the C model keeps both, so the random
# RTL tests run without these macros;
set_global_assignment -name VERILOG_MACRO "MRDP_NO_2CYCLE=1"
set_global_assignment -name VERILOG_MACRO "MRDP_NO_TEXRECT=1"
# and MRDP's PRIM / ENV / FOG colours: the geometry core bakes them into the
# vertex colours (GDL_CCOLOR), so their combiner and blender inputs go.
# MRDP's small triangle microcode ROM in LUTs: its M10K output started the
# failing paths of every seed once the game CPU went big-endian
set_global_assignment -name VERILOG_MACRO "MRDP_UCODE_LOGIC=1"
set_global_assignment -name VERILOG_MACRO "CMDQ_AW=12"
set_global_assignment -name VERILOG_MACRO "MIRLO_NO_JTAG_UART=1"
set_global_assignment -name SAVE_DISK_SPACE OFF
# The design uses ~98 % of the device's ALMs, and whether it closes timing
# depends on the fitter seed: after an RTL change, if setup slack goes
# negative, compile three seeds in parallel (copies of projects/ with a
# different SEED each) and keep the one that closes. With
# PLACEMENT_EFFORT_MULTIPLIER 10.0 (below).
set_global_assignment -name SEED 34
# Off: smart recompilation can skip synthesis when only a memory's init file
# changed -- the geometry core's ROM is one.
set_global_assignment -name SMART_RECOMPILE OFF

# ==============================================================================
# Analysis & Synthesis Assignments
# ==============================================================================
# Area (2026-10-06, branch own-area): wide multiplexers restructured everywhere but in the
# game CPU and its FPU (their 93.75 MHz paths do not close with it: the branch target
# after the forwarding, the FPU's results), the small memories (MLAB / M10K) recognised at
# any size, and the two netlist resynthesis passes off. The fit of the same design
# (MIRLO_RSP=1 MIRLO_RSP_LANES=4 MIRLO_RSP_MULW=1 MIRLO_TLB_RAM=1 MIRLO_GB_CART=1
# MIRLO_CPU_CLK=32 MIRLO_CPU_IC_LOG2=10 MIRLO_CPU_DC_LOG2=10 MIRLO_CLK_N64=1 MIRLO_MON=1)
# went from 17,901 to ~15,400 ALMs; seeds 5 and 20 close.
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP OFF
set_global_assignment -name MUX_RESTRUCTURE ON
set_instance_assignment -name MUX_RESTRUCTURE OFF -to "core_top:ic|mirlo_mips:soc|mips_sys:sys"
set_global_assignment -name ALLOW_ANY_RAM_SIZE_FOR_RECOGNITION ON
set_global_assignment -name ALLOW_ANY_ROM_SIZE_FOR_RECOGNITION ON
# Area (2026-10-09, branch own-area2): the synthesis in AREA mode maps the same design with ~1,000 fewer
# LUTs than SPEED (rsp_vu -3 %, rdp -2 %, mirlo_regs -8 %, the FPU -8 %, the CPU -6 %). It is global: no
# instance assignment of OPTIMIZATION_TECHNIQUE (nor an altera_attribute on the module) is honoured in this
# Quartus. What broke the CPU's clock with it (fpu_n64's bypass compare, the first path of every seed, -0.6 ns)
# is fixed in the RTL; the physical synthesis stays ON, at its FAST effort (Normal duplicates 1,500 registers,
# ~320 ALMs more than FAST, for nothing the clocks need) and PLACEMENT_EFFORT_MULTIPLIER is 10. The closing
# set (docs/mips.md): 17.4-17.5k ALMs (94-95 %); of eight seeds 12, 5, 20, 3, 41 and 27 close (34 by -0.03
# ns of hold in the fast 0C corner, 9 by -0.08 ns of setup on the CPU's clock).
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT FAST
set_global_assignment -name PRE_MAPPING_RESYNTHESIS OFF
set_global_assignment -name SAFE_STATE_MACHINE ON
set_global_assignment -name SYNTH_PROTECT_SDC_CONSTRAINT ON

# ==============================================================================
# Fitter Assignments
# ==============================================================================
set_global_assignment -name ACTIVE_SERIAL_CLOCK FREQ_100MHZ
set_global_assignment -name CRC_ERROR_OPEN_DRAIN ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "PASSIVE SERIAL"

