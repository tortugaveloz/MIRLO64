set_global_assignment -name ENABLE_SIGNALTAP OFF
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 10.0
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
# GeomSetupUnit build options (rtl/vpu/GeomSetupUnit.v): the full unit, RECIPN
# and NORMF included. Their SU_NO_RECIP / SU_NO_NORMF switches (removed from the
# RTL in the 2026-10 cleanup; they are in the history) were for when
# area gets tight again -- then build lang/c/geom with
# CFLAGS_EXTRA=-DGEOM_SU_PROBE, so it probes for both at boot and falls back to
# its C (geom_setup_probe()); by default it assumes this full unit. Full is ~1,790 ALMs, ~1,430 without the
# two -- as small as the old reduced set, since the unit's float<->fixed
# conversion ops went when the triangle stream became fixed point.

# The PSRAMs' pads (rtl/soc/psram.sv): every register at its pad
